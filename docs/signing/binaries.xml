<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="caelestia-helper.exe" product-name="Caelestia for Windows" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="caelestia-launcher.exe" product-name="Caelestia" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="CaelestiaSwitcher.exe" product-name="Caelestia" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
